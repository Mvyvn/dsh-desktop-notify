{
  "name": "dsh-desktop-notify",
  "version": "1.4.0",
  "description": "DSH桌面通知",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "koffi": "^3.1.6"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "windows-toast",
    "winrt",
    "dbus",
    "cordis"
  ],
  "author": "沐云 (Mvyvn) <mvyvn@qq.com>",
  "contributors": [
    "苏拾柒 <seventeen_su@proton.me>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Mvyvn/dsh-desktop-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mvyvn/dsh-desktop-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Mvyvn/dsh-desktop-notify/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
