{
  "name": "dsh-desktop-notify",
  "version": "1.8.10",
  "description": "DSH桌面通知",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.platform.json && tsc -p tsconfig.client.json",
    "check": "node scripts/check-syntax.mjs",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "koffi": "^3.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "windows-toast",
    "winrt",
    "dbus",
    "cordis"
  ],
  "author": "沐云 (Mvyvn) <mvyvn@qq.com>",
  "contributors": [
    "苏拾柒 <seventeen_su@proton.me>"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Mvyvn/dsh-desktop-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mvyvn/dsh-desktop-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Mvyvn/dsh-desktop-notify/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3"
  }
}
