{
  "name": "dsh-desktop-notify",
  "version": "1.1.0",
  "description": "DSH 桌面通知 — 任务完成 / 等待输入 / 审批被拒 / 后台任务结束时通过 desktop-notifier 发送 Windows Toast（仅 DSH 页面不可见时）。Installed as a real web-profile plugin: auto-loads on every dsh web start, no approval needed.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "desktop-notifier",
    "windows-toast",
    "cordis"
  ],
  "author": "沐云 (Mvyvn) <mvyvn@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/Mvyvn/dsh-desktop-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mvyvn/dsh-desktop-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Mvyvn/dsh-desktop-notify/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
