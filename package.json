{
  "name": "@mvyvn/dsh-desktop-notify",
  "version": "2.1.0",
  "description": "使用系统推送 DSH 的提醒",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "assets/*.png",
    "assets/*.ico",
    "assets/*.js",
    "locale/*.json",
    "assets/*.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.platform.json && tsc -p tsconfig.client.json",
    "check": "node scripts/check-syntax.mjs",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "koffi": "^3.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "windows-toast",
    "winrt",
    "dbus",
    "cordis",
    "desktop-notification",
    "toast",
    "windows",
    "linux",
    "macos"
  ],
  "author": "沐云 (Mvyvn) <mvyvn@qq.com>",
  "contributors": [
    "苏拾柒 <seventeen_su@proton.me>"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Mvyvn/dsh-desktop-notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mvyvn/dsh-desktop-notify.git"
  },
  "bugs": {
    "url": "https://github.com/Mvyvn/dsh-desktop-notify/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3"
  },
  "meta": {
    "title": "DSH 系统通知",
    "description": "使用系统推送 DSH 的提醒"
  },
  "icon": "./assets/icon.svg",
  "publishConfig": {
    "access": "public"
  }
}
